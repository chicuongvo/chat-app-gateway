NODE_ENV=development
GATEWAY_PORT=4000

# Must match the JWT_SECRET used by auth-service
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# Must match INTERNAL_API_TOKEN across all services
INTERNAL_API_TOKEN=your-super-secret-internal-token-32chars

# Downstream service URLs (use container names in Docker, localhost for local dev)
AUTH_SERVICE_URL=http://localhost:4003
USER_SERVICE_URL=http://localhost:4001
CHAT_SERVICE_URL=http://localhost:4002
MULTIMEDIA_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4010
REALTIME_SERVICE_URL=http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# ============================================
# Cloud Deploy (Fly.io)
# ============================================
# Set these as fly secrets:
#   fly secrets set JWT_SECRET=... INTERNAL_API_TOKEN=... -a chatapp-gateway
#
# Set service URLs after each Render service is deployed:
#   AUTH_SERVICE_URL=https://chatapp-auth-service.onrender.com
#   USER_SERVICE_URL=https://chatapp-user-service.onrender.com
#   CHAT_SERVICE_URL=https://chatapp-chat-service.onrender.com
#   MULTIMEDIA_SERVICE_URL=https://chatapp-multimedia-service.onrender.com
#   NOTIFICATION_SERVICE_URL=https://chatapp-notification-service.onrender.com
#   REALTIME_SERVICE_URL=https://chatapp-realtime.fly.dev
# ============================================
