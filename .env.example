NODE_ENV=development
GATEWAY_PORT=4000

# Must match the JWT_SECRET used by auth-service
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# Must match INTERNAL_API_TOKEN across all services
INTERNAL_API_TOKEN=your-super-secret-internal-token-32chars

# Downstream service URLs (use container names in Docker, localhost for local dev)
AUTH_SERVICE_URL=http://localhost:4003
USER_SERVICE_URL=http://localhost:4001
CHAT_SERVICE_URL=http://localhost:4002
MULTIMEDIA_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4010
REALTIME_SERVICE_URL=http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
